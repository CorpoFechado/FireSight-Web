# ---------------------------------------------------------
# FireSight Fire & Smoke AI Detection Service (.env)
# ---------------------------------------------------------

# Streaming Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
JPEG_QUALITY=80

# Default / Fallback RTSP Stream (Optional - can be overridden per resident from mobile app)
CAMERA_IP=192.168.1.100
RTSP_PORT=554
RTSP_STREAM_PATH=stream2
RTSP_USER=admin
RTSP_PASSWORD=password
# RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream2

# Laravel Backend Webhook Integration
LARAVEL_API_URL=http://127.0.0.1:8000/api/cctv/alert
CCTV_WEBHOOK_SECRET=firesight_cctv_secret_key
